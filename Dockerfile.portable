# syntax=docker/dockerfile:1

# A portable Linux build.
#
# The point of this image is its base, not its contents. A binary cannot run
# against a glibc older than the one it was linked with, and glibc 2.34 folded
# libpthread, libdl and librt into libc itself - so every threaded program built
# on Ubuntu 22.04 or newer demands GLIBC_2.34 and refuses to start on Ubuntu
# 20.04, Debian 11 or RHEL 8. This is not something a compiler flag can undo,
# which is why the answer is a different base rather than a different build.
#
# Building here pins the floor at 20.04's glibc 2.31, which covers Ubuntu 20.04
# and later and Debian 11 and later. For an older floor still, change
# UBUNTU_VERSION or move to a distribution older than any Ubuntu that can host
# a C++20 compiler.
#
#   docker build -f Dockerfile.portable --target export --output type=local,dest=dist .
#
# leaves the binaries in dist/. libstdc++ and libgcc are already linked
# statically by the main build; libssl and libc stay dynamic.
#
# This is separate from Dockerfile because that one builds the published
# container image, where the runtime base and the build base are the same
# modern Ubuntu and none of the above applies.

ARG UBUNTU_VERSION=20.04

FROM ubuntu:${UBUNTU_VERSION} AS build
ARG DEBIAN_FRONTEND=noninteractive

# g++-10, not 20.04's default g++-9: the bundled RocksDB builds as C++20 and
# uses defaulted comparison operators, which GCC 9 does not implement. It comes
# from 20.04's own universe repository, so no PPA is involved and the glibc this
# links against stays exactly where it is.
#
# CMake comes from Kitware for the same reason the main Dockerfile takes it from
# there: 20.04 ships 3.16, and the vendored RocksDB expects newer.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gpg && \
    curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor - > /usr/share/keyrings/kitware-archive-keyring.gpg && \
    . /etc/os-release && \
    echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ ${UBUNTU_CODENAME} main" \
        > /etc/apt/sources.list.d/kitware.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils \
        cmake \
        g++-10 \
        gcc-10 \
        git \
        libssl-dev \
        ninja-build \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# ARCH=default is the other half of portability: without it the build targets
# whatever CPU happens to be compiling, and the binary dies with an illegal
# instruction on anything older.
RUN CC=gcc-10 CXX=g++-10 cmake -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D ARCH=default \
        -D SET_COMMIT_ID_IN_VERSION=OFF \
        -D CMAKE_INSTALL_PREFIX=/out \
        -S . -B build && \
    cmake --build build --target install

# Report the floor that was actually achieved. If the base image is changed to
# something newer, this line says so in the build log rather than leaving it to
# be discovered on a server.
RUN echo "glibc floor: $(objdump -T /out/bin/DeroGoldd \
        | grep -oE 'GLIBC_[0-9.]+' | sort -uV | tail -1)"

FROM scratch AS export
COPY --from=build /out/bin/ /
